# Keep the preview addresses out of search engines. futureforth.com itself must stay indexable.
https://futureforth-site.pages.dev/*
  X-Robots-Tag: noindex

https://:version.futureforth-site.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted files never change, so browsers can keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names; a week is a safe cache.
/images/*
  Cache-Control: public, max-age=604800
