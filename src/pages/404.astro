---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Houston, we have a problem. - Futureforth" description="This page could not be found." path="/404" noindex>
  <section class="section">
    <div class="container prose">
      <h1>🙄 404 Error.</h1>
      <p>Oops! We've hit a miscommunication. It looks like this page got lost in translation.</p>
      <p><a href="/" class="btn btn-primary">Let's get you back on track</a></p>
    </div>
  </section>
</BaseLayout>
