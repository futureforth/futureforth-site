---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/pages.json';
import tool from '../tools/churn-calculator.html?raw';
const page = pages['churn-calculator'];
---
<BaseLayout
  title="Employee Churn Calculator - Futureforth"
  description="See what it really costs to replace an employee who quits with this free employee churn calculator."
  path="/churn-calculator"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" style="color: var(--color-accent);">Free Tool</p>
      <h1>Employee Churn Calculator</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Fragment set:html={page.html} />
    </div>
  </section>
  <section class="section section--alt" id="tool">
    <div class="container">
      <Fragment set:html={tool} />
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p><a href="/freetools">&larr; All free tools</a></p>
    </div>
  </section>
</BaseLayout>
