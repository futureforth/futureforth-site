---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { img } from '../../lib/images.js';
import episodes from '../../data/podcast.json';
import { FEED_URL } from '../../lib/podcast-audio.js';
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="Nice Podcast with Dave Delaney - Futureforth"
  description="Conversations with leaders about communication, culture, leadership and retention, hosted by Dave Delaney."
  path="/nice-podcast"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" style="color: var(--color-accent);">{episodes.length} episodes</p>
      <h1>Nice Podcast with Dave Delaney</h1>
      <p class="lede" style="color:#dbe3ee;">Conversations with leaders about communication, culture, leadership and retention.</p>
      <div class="hero__actions">
        <a href={FEED_URL} class="btn btn-primary">Subscribe via RSS</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ul class="post-list">
        {episodes.map((e) => (
          <li class="post-list__item">
            {e.image && <a href={`/nice-podcast/${e.slug}`} tabindex="-1" aria-hidden="true"><img src={img(e.image)} alt="" loading="lazy" width="120" height="120" sizes="120px" /></a>}
            <div>
              <p class="post-list__date">{fmt(e.date)}</p>
              <h2><a href={`/nice-podcast/${e.slug}`}>{e.title}</a></h2>
              <p>{e.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
