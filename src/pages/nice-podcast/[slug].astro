---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { img, localize } from '../../lib/images.js';
import episodes from '../../data/podcast.json';
import { audioFor } from '../../lib/podcast-audio.js';

export async function getStaticPaths() {
  const paths = await Promise.all(
    episodes.map(async (episode, i) => ({
      params: { slug: episode.slug },
      props: { episode, audio: await audioFor(episode), newer: episodes[i - 1], older: episodes[i + 1] },
    }))
  );
  const silent = paths.filter((p) => !p.props.audio).map((p) => p.params.slug);
  if (silent.length) console.warn(`[podcast] ${silent.length} of ${paths.length} episodes have no audio: ${silent.join(', ')}`);
  return paths;
}
const { episode, audio, newer, older } = Astro.props;
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title={`${episode.title} - Nice Podcast`}
  description={episode.excerpt}
  path={`/nice-podcast/${episode.slug}`}
  image={episode.image ? img(episode.image) : undefined}
>
  <article class="section">
    <div class="container prose">
      <p class="eyebrow"><a href="/nice-podcast">Nice Podcast</a> &middot; {fmt(episode.date)}</p>
      <h1>{episode.title}</h1>
      {audio && (
        <audio controls preload="none" src={audio} class="episode-player">
          <a href={audio}>Download this episode</a>
        </audio>
      )}
      <Fragment set:html={localize(episode.html)} />
      <nav class="post-nav" aria-label="More episodes">
        {older ? <a href={`/nice-podcast/${older.slug}`}>&larr; {older.title}</a> : <span />}
        {newer ? <a href={`/nice-podcast/${newer.slug}`}>{newer.title} &rarr;</a> : <span />}
      </nav>
    </div>
  </article>
</BaseLayout>
