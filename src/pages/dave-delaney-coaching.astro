---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/titillium.css';
import { localize } from '../lib/images.js';
// The page body is the live Squarespace code block for the coaching page (October 2026 redesign).
// Its styles are scoped to #ff-coaching, and its images come from the local copies in /images/sq/.
import body from '../tools/coaching.html?raw';
---
<BaseLayout
  title="Business Coach in Nashville: Dave Delaney. - Futureforth"
  description="Looking for a business coach in Nashville to boost your communication strategy and business growth? Dave Delaney helps entrepreneurs and executives strengthen their professional development and lead with clarity and confidence."
  path="/dave-delaney-coaching"
  image="/images/sq/73ad0d054d-ncs42024-02013.webp"
>
  <Fragment set:html={localize(body)} />
</BaseLayout>
