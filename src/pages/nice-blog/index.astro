---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { img } from '../../lib/images.js';
import posts from '../../data/blog.json';
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="Bring the Nice Blog - Futureforth"
  description="Articles from Dave Delaney on communication, leadership, culture and employee retention."
  path="/nice-blog"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" style="color: var(--color-accent);">{posts.length} articles</p>
      <h1>Bring the Nice</h1>
      <p class="lede" style="color:#ead9eb;">Articles on communication, leadership, culture and employee retention.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <aside class="archive-notice" aria-label="Blog archive notice">
        <div class="archive-notice__text">
          <p class="eyebrow" style="color: var(--color-accent-strong);">Archive</p>
          <h2>This blog is an archive</h2>
          <p>For new content, subscribe to Dave Delaney's <a href="https://nicemaker.substack.com/">Nice Maker on Substack</a>.</p>
        </div>
        <iframe
          class="archive-notice__form"
          src="https://nicemaker.substack.com/embed"
          title="Subscribe to The Nice Maker on Substack"
          width="480"
          height="320"
          frameborder="0"
          scrolling="no"
          loading="lazy"
        ></iframe>
      </aside>
      <ul class="post-list">
        {posts.map((p) => (
          <li class="post-list__item">
            {p.image && <a href={`/nice-blog/${p.slug}`} tabindex="-1" aria-hidden="true"><img src={img(p.image)} alt="" loading="lazy" width="120" height="120" sizes="120px" /></a>}
            <div>
              <p class="post-list__date">{fmt(p.date)}</p>
              <h2><a href={`/nice-blog/${p.slug}`}>{p.title}</a></h2>
              <p>{p.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .archive-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    background: var(--color-cream-100);
    border-left: 4px solid var(--color-accent);
    border-radius: 6px;
  }
  .archive-notice__text { flex: 1 1 280px; }
  .archive-notice__text h2 { margin: 0.25rem 0 0.5rem; font-size: 1.4rem; }
  .archive-notice__text p:last-child { margin: 0; }
  .archive-notice__form {
    flex: 1 1 320px;
    max-width: 480px;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #fff;
  }
</style>
