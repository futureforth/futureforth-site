---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/titillium.css';
import { localize } from '../lib/images.js';
import { organizationSchema, daveDelaneyPersonSchema } from '../data/schema.js';
// The page body is the original Squarespace code block (its styles are scoped to #ff-home).
// Its two inline photos were moved out to /images/home-*.webp.
import body from '../tools/home.html?raw';
---
<BaseLayout
  title="Futureforth - Communication Strategy | Keynote Speaker | Workshop Facilitation | Coaching &amp; Consulting."
  description="Futureforth helps Nashville and national teams communicate better through executive coaching, workshops, and keynote speaking led by Dave Delaney."
  path="/"
  image="/images/og-default.jpg"
  jsonLd={[organizationSchema, daveDelaneyPersonSchema]}
>
  <Fragment set:html={localize(body)} />
</BaseLayout>
