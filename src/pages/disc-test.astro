---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localize } from '../lib/images.js';
import pages from '../data/pages.json';
import tool from '../tools/disc-test.html?raw';
const page = pages['disc-test'];
---
<BaseLayout
  title="Free DISC Test - Futureforth"
  description="Take a quick, free DISC test to discover your communication and leadership style."
  path="/disc-test"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" style="color: var(--color-accent);">Free Tool</p>
      <h1>Free DISC Test</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Fragment set:html={localize(page.html)} />
    </div>
  </section>
  <section class="section section--alt" id="tool">
    <div class="container">
      <Fragment set:html={localize(tool)} />
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p><a href="/freetools">&larr; All free tools</a></p>
    </div>
  </section>
</BaseLayout>
