---
import BaseLayout from '../layouts/BaseLayout.astro';
// The page body is the original Squarespace code block (its styles are scoped to #ff-10x).
import body from '../tools/10xcc.html?raw';
---
<BaseLayout
  title="10X Conference Coaching - Futureforth"
  description="Get a real return from your next conference sponsorship, exhibit or speaking slot with a plan for before, during and after the event."
  path="/10xcc"
  image="/images/10x-og.jpg"
>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;800;900&display=swap" />
  <Fragment set:html={body} />
</BaseLayout>
