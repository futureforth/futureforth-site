---
const { what = 'blog' } = Astro.props;
---
<aside class="archive-notice" aria-label="Archive notice">
  <div class="archive-notice__text">
    <p class="eyebrow" style="color: var(--color-accent-strong);">Archive</p>
    <h2>This {what} is an archive</h2>
    <p>For new content, subscribe to Dave Delaney's <a href="https://nicemaker.substack.com/">Nice Maker on Substack</a>.</p>
  </div>
  <iframe
    class="archive-notice__form"
    src="https://nicemaker.substack.com/embed"
    title="Subscribe to The Nice Maker on Substack"
    width="480"
    height="320"
    frameborder="0"
    scrolling="no"
    loading="lazy"
  ></iframe>
</aside>
<style>
  .archive-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    background: var(--color-cream-100);
    border-left: 4px solid var(--color-accent);
    border-radius: 6px;
  }
  .archive-notice__text { flex: 1 1 280px; }
  .archive-notice__text h2 { margin: 0.25rem 0 0.5rem; font-size: 1.4rem; }
  .archive-notice__text p:last-child { margin: 0; }
  .archive-notice__form {
    flex: 1 1 320px;
    max-width: 480px;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #fff;
  }
</style>
