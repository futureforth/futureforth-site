---
// Site header: no navigation, just the white Futureforth logo (brand-approved monochrome
// version) on brand purple, linking home. The homepage hides this and shows a larger logo in its hero.
---
<header class="site-brandbar">
  <div class="container">
    <a href="/" class="site-brandbar__logo" aria-label="Futureforth home">
      <img src="/images/Futureforth_h_white.png" alt="Futureforth" width="127" height="40" />
    </a>
  </div>
</header>

<style>
  .site-brandbar { background: var(--color-navy-800); padding-block: 14px; }
  .site-brandbar__logo { display: inline-block; }
  .site-brandbar__logo img { display: block; height: 40px; width: auto; }
</style>
