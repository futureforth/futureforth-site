---
interface GalleryImage {
  src: string;
  alt: string;
}
interface Props {
  images: GalleryImage[];
}
const { images } = Astro.props as Props;
---
<div class="gallery">
  {images.map((img) => (
    <img src={img.src} alt={img.alt} loading="lazy" width="400" height="300" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw" />
  ))}
</div>
