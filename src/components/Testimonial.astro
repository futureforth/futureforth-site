---
interface Props {
  quote: string;
  name: string;
  role?: string;
  logo?: string;
  logoAlt?: string;
}
const { quote, name, role, logo, logoAlt = '' } = Astro.props as Props;
---
<div class="testimonial">
  {logo && <img class="testimonial__logo" src={logo} alt={logoAlt} loading="lazy" />}
  <blockquote>&ldquo;{quote}&rdquo;</blockquote>
  <cite>{name}{role && `, ${role}`}</cite>
</div>
